  "issues": [
    {
      "number": 1,
      "id": "I_kwDOPJthjs6_uqpc",
      "title": "How to interpret authorized-by in evidence?",
      "url": "https://github.com/ietf-rats-wg/draft-ietf-rats-corim-swid-triple/issues/1",
      "state": "OPEN",
      "author": "deeglaze",
      "authorAssociation": "COLLABORATOR",
      "assignees": [
        "nedmsmith"
      ],
      "labels": [],
      "body": "From the TCG SPDM DICE evidence binding specification\n\n> The authorized-by item SHOULD be included in Evidence if Reference Values are supplied by an entity other than\nthe supplier of the Attester.\n\nI'm not entirely sure why the Attester should be including in evidence who is expected to authorize the software it has just measured.\nI this meant more as a hint rather than some strange inversion of policy?",
      "createdAt": "2025-07-09T17:41:19Z",
      "updatedAt": "2025-07-09T17:41:33Z",
      "closedAt": null,
      "comments": []
    },
    {
      "number": 2,
      "id": "I_kwDOPJthjs6_woIN",
      "title": "Is CoMID-CoSWID a complete or partial inventory?",
      "url": "https://github.com/ietf-rats-wg/draft-ietf-rats-corim-swid-triple/issues/2",
      "state": "OPEN",
      "author": "deeglaze",
      "authorAssociation": "COLLABORATOR",
      "assignees": [
        "nedmsmith"
      ],
      "labels": [],
      "body": "It's important to know if additional evidence for software that has no reference information should disqualify the evidence for a given linking triple.\n\nExtra files should not matter only if the triple is for a partial inventory.",
      "createdAt": "2025-07-09T21:25:21Z",
      "updatedAt": "2025-07-09T21:35:49Z",
      "closedAt": null,
      "comments": [
        {
          "author": "deeglaze",
          "authorAssociation": "COLLABORATOR",
          "body": "If we need an requirelist/denylist intepretation for partial inventories, we should just create another triple for that purpose. I'd like to keep the interpretation unambiguous.",
          "createdAt": "2025-07-09T21:35:49Z",
          "updatedAt": "2025-07-09T21:35:49Z"
        }
      ]
    }
  ],
